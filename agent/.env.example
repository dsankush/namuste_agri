# Copy to .env.local for local runs. On LiveKit Cloud these become agent secrets.
# LIVEKIT_* are filled by `lk app env` locally and injected automatically on LiveKit Cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=
SARVAM_API_KEY=
SUPABASE_URL=https://merbxpgjarsjxxsyeiyt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning
OPENAI_MODEL=gpt-4.1-mini
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=1.0
AGENT_NAME=kisan-sathi
AGENT_BRAND_NAME=Kisan Sathi

# WhatsApp notifications (order confirmed/cancelled, crop advisory given,
# callback received) — sent to the namuste-site handler, which composes
# and sends the actual WhatsApp template. Same secret value must be set as
# AGRI_NOTIFY_SECRET on namuste-site's Vercel project too, or every
# notification silently fails its auth check.
AGRI_NOTIFY_SECRET=
# Optional — defaults to https://namuste.com/api/whatsapp/agri-event
WHATSAPP_NOTIFY_URL=
